# GitHub (fetched server-side, cached 1h)
GITHUB_TOKEN=

# Vercel Blob (for AI stats upload only)
BLOB_READ_WRITE_TOKEN=
REVALIDATE_SECRET=
SITE_URL=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Analytics (optional — omit to disable GA + consent banner + privacy page link)
NEXT_PUBLIC_GA_ID=

# Vercel Speed Insights (optional — set to "1" to enable)
NEXT_PUBLIC_SPEED_INSIGHTS=

# Vercel Analytics (optional — set to "1" to enable)
NEXT_PUBLIC_VERCEL_ANALYTICS=

# Canonical URL override (optional — defaults to siteConfig.url in src/config/site.ts)
NEXT_PUBLIC_SITE_URL=
